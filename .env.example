# ── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# LLM Provider: "openai" (cloud, OpenAI-compatible fallback chain) or
# "ollama" (fully local). Use "openai" for the Hugging Face / cloud demo.
LLM_PROVIDER=openai

# ── PRIMARY generation endpoint — Groq ───────────────────────────────────────
# Groq is OpenAI-compatible and its free tier (~30 req/min, ~1000 req/day, no
# credit card) is a much better fit for a hosted demo than OpenRouter's 50/day.
# 1. Create a key at https://console.groq.com/keys  (starts with gsk_)
# 2. Paste it below. On Hugging Face Spaces, set it as a Space *secret* instead.
# NOTE: this is a cloud API — prompt text (incl. patient data) leaves the device.
GROQ_API_KEY=gsk_your-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Faster / higher-throughput alternative: openai/gpt-oss-20b
# (Groq retired the Llama 3.x chat models on 2026-08-16.)
# List the models your key can actually access:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"

# ── FALLBACK generation endpoint — OpenRouter ────────────────────────────────
# Used automatically only if the Groq call fails / is rate-limited.
# Create a key at https://openrouter.ai/keys  (starts with sk-or-v1-)
OPENAI_API_KEY=sk-or-v1-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-ultra
# Optional OpenRouter attribution headers
OPENROUTER_APP_NAME=medical-rag
# OPENROUTER_SITE_URL=https://your-site.example

# Try endpoints in priority order (Groq → OpenRouter). Set false to use only
# the highest-priority key that is set.
LLM_FALLBACK_ENABLED=true

# Alternative fallback hosts (swap the OPENAI_* lines):
#   HF Inference : OPENAI_BASE_URL=https://router.huggingface.co/v1  (key: hf_…)
#   NVIDIA NIM   : OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1  (key: nvapi-…)
#   OpenAI       : OPENAI_BASE_URL=https://api.openai.com/v1  OPENAI_MODEL=gpt-4o-mini

# ── Ollama — ALWAYS required for embeddings (nomic-embed-text) ───────────────
# 1. Install Ollama from https://ollama.com
# 2. Run once: ollama pull nomic-embed-text
# 3. Keep Ollama running in the background while using this app
# Also serves generation when LLM_PROVIDER=ollama (then: ollama pull devstral:24b)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=devstral:24b

# ── Storage ───────────────────────────────────────────────────────────────────
# BUCKET_DIR points to the local bucket/ folder (mounted via docker-compose.yml).
# To upgrade to S3: set BUCKET_DIR to your S3 URI and update ingestion.py loaders.
BUCKET_DIR=/app/bucket

# Automatically ingest all files from bucket/ when the backend starts
AUTO_INGEST=true
