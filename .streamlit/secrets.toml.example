# ─────────────────────────────────────────────────────────────────────────────
# Streamlit secrets TEMPLATE — do NOT put real keys here or commit this file.
#
# On Streamlit Community Cloud: open your app → Settings → Secrets, and paste
# the lines below (with real values). Locally, you may copy this to
# .streamlit/secrets.toml (gitignored) for testing.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — primary LLM (Groq). Create at https://console.groq.com/keys
GROQ_API_KEY = "gsk_your_key_here"
GROQ_MODEL   = "openai/gpt-oss-120b"

# OPTIONAL — fallback LLM, used only if the Groq call fails / is rate-limited.
# Create at https://openrouter.ai/keys
OPENAI_API_KEY  = "sk-or-v1-your_key_here"
OPENAI_MODEL    = "nvidia/nemotron-3-ultra"
OPENAI_BASE_URL = "https://openrouter.ai/api/v1"

# OPTIONAL — behaviour toggles (defaults shown).
LLM_FALLBACK_ENABLED       = "true"
ENABLE_HALLUCINATION_CHECK = "false"   # keep off to use 1 LLM call per question
